# Real authentication and patient records. This fails closed until configured.
NEXT_PUBLIC_APP_MODE=live

# Switch to live ONLY after configuring Clerk + deploying the Convex functions.
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# APP_ORIGIN=https://your-application-domain
# Production preflight requires pk_live_/sk_live_ keys and HTTPS origins.
# Set the same APP_ORIGIN on the Convex deployment for authenticated uploads.

# For isolated local fixture testing only, explicitly use NEXT_PUBLIC_APP_MODE=demo.
# Unset mode defaults to fixtures in development, but to live in production builds.

# Dedicated authentication routes (also configured on ClerkProvider).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/family/overview
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/signup/voice
