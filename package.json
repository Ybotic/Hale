{
  "name": "hale",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names convex,dashboard,mobile --prefix-colors cyan,green,blue \"pnpm dev:convex\" \"pnpm dev:dashboard\" \"pnpm dev:mobile\"",
    "dev:mobile": "pnpm --filter @care/mobile dev",
    "dev:dashboard": "pnpm --filter @care/dashboard dev",
    "dev:convex": "convex dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc --noEmit -p convex/tsconfig.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "lint": "turbo lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.2.12",
    "@care/shared": "workspace:*",
    "ai": "^4.3.16",
    "convex": "^1.17.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "convex-test": "^0.0.38",
    "vitest": "^2.1.9"
  }
}
