# Copy to apps/web/.env.local for local development. Never commit real credentials.
NEXT_PUBLIC_APP_MODE=demo

# TigerData (managed PostgreSQL / TimescaleDB) connection string.
# TIGERDATA_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Server-only integration keys. Never prefix these with NEXT_PUBLIC_.
# BACKBOARD_API_KEY=your-backboard-api-key
# BACKBOARD_PROCESSING_ENABLED=false
# NESSIE_API_KEY=your-nessie-api-key
# NESSIE_API_BASE_URL=https://api.nessieisreal.com
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_CHAT_MODEL=liquid/lfm-2.5-2.6b:free
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
# PYANNOTE_API_KEY=your-pyannote-api-key
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
# TRANSCRIPTION_ONLY=true skips pyannote diarization and voice matching, leaving speakers unnamed.
# LOCAL_WHISPER_GPU=true
# LOCAL_WHISPER_PYTHON=/path/to/.venv/bin/python
# HALE_WHISPER_MODEL=large-v3
# PYMUPDF_PYTHON=/path/to/.venv/bin/python
# CALCOM_BOOKING_URL=https://cal.com/your-test-event
# WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
# WEB_PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# Required in live mode; use the deployed app's origin without a path.
# APP_ORIGIN=https://your-application-domain
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/family/overview
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/signup/voice
